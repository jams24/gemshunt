# ============ REQUIRED ============

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/solana_sniper

# Wallet encryption — MUST be exactly 64 hex characters (32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The bot refuses to start without a valid key. Changing it makes every stored
# wallet permanently unreadable — back it up before you deploy.
ENCRYPTION_KEY=

# Solana RPC (Helius free tier: https://dev.helius.xyz)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

# ============ TRADING ============

MAX_BUY_SOL=0.1
MAX_OPEN_POSITIONS=5
AUTO_SELL_ENABLED=true
DEFAULT_SLIPPAGE_BPS=500
POSITION_CHECK_INTERVAL=30

# Platform fee, in percent, taken per buy
PLATFORM_FEE_PCT=1
REFERRAL_FEE_SHARE=0.25

# Fee wallets are per-chain — an EVM address cannot receive SOL.
# FEE_WALLET_ADDRESS is the legacy Solana fallback.
FEE_WALLET_ADDRESS=
FEE_WALLET_ADDRESS_SOL=
FEE_WALLET_ADDRESS_EVM=

# ============ ALERTS ============

# Minimum conviction score (0-100) before a token is pushed to anyone.
# Each user can raise their own bar with /setscore.
ALERT_MIN_SCORE=60
ALERT_MIN_LIQUIDITY=5
ALERT_MAX_PER_MINUTE=10

# ============ ON-CHAIN TRACKING ============

# Snapshots every alerted token for TRACK_HOURS whether or not we bought it.
# This is what powers /analytics and deployer reputation — turning it off
# means the thesis engine stops learning.
TRACKER_ENABLED=true
TRACKER_SNAPSHOT_INTERVAL=120
TRACKER_TRACK_HOURS=24
