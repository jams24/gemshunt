# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/solana_sniper

# Solana RPC (Helius free tier: https://dev.helius.xyz)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Wallet (base58 private key)
WALLET_PRIVATE_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

# Trading Config
MAX_BUY_SOL=0.1
MAX_OPEN_POSITIONS=5
AUTO_SELL_ENABLED=true
